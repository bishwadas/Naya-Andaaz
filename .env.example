# ==========================================================
# NAYA ANDAAZ — ENVIRONMENT CONFIGURATION
# ==========================================================

# 1. Persistent Storage & Database Configuration (SQLite)
# Default persistent volume mount path: /data (or ./data for local development)
DATA_DIR=/data
DATABASE_URL=file:/data/nayaandaaz.db

# 2. First-Run Admin Account Initialization (Optional)
# Used during 'npm run db:setup' or on initial boot if no administrator exists
ADMIN_NAME=Naya Andaaz Administrator
ADMIN_EMAIL=admin@nayaandaaz.com
ADMIN_PASSWORD=

# 3. AI Features & Summaries
GEMINI_API_KEY=

# 4. Authentication & Security
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 5. Email & Notifications (Transactional OTP & Newsletters)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_FROM_EMAIL=

# 6. Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
