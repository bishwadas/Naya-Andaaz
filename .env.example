# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL Database Connection URL (Drizzle ORM & node-postgres)
DATABASE_URL="postgresql://neondb_owner:npg_emQYGk2AbT3v@ep-super-silence-azzi6708-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Session & Security
SESSION_SECRET="sereia_secure_jwt_session_secret_key_2026"

# Resend API for transactional emails (email verification, password reset)
RESEND_API_KEY="re_NkSqQLXK_DRGamm2SrvCakSCR4xVBPoLa"
RESEND_FROM_EMAIL="Sereia Gazette <onboarding@resend.dev>"

# Temporarily disable signup email verification when no custom sending domain is available.
# Set to true to restore the existing OTP/Resend signup flow.
EMAIL_VERIFICATION_ENABLED=false

