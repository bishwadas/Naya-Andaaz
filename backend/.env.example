# Django Secret Key (Generate a random 50+ character string for production)
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-sereia-news-cms

# Environment: development, staging, production
DJANGO_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://sereia_user:sereia_password@localhost:5432/sereia_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sereia_db
DB_USER=sereia_user
DB_PASSWORD=sereia_password

# CORS Configuration (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication
JWT_SECRET_KEY=django-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis / Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0

# Media & Static Storage
MEDIA_URL=/media/
STATIC_URL=/static/
